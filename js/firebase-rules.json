{
  "rules": {
    "online": {
      ".read": true,
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{6,16}$/)",
        ".validate": "!newData.exists() || newData.isNumber()"
      }
    },
    "visits": {
      ".read": true,
      "$month": {
        ".write": "$month.matches(/^[0-9]{4}-[0-9]{2}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1",
        ".validate": "newData.isNumber()"
      }
    }
  }
}
